# LLM Provider Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embedding Provider Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Database Configuration (PostgreSQL + pgvector / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pr_reviewer
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/pr_reviewer

# GitHub Integration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=development_webhook_secret_key_32_bytes_min
POST_GITHUB_COMMENTS=false

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
