# Ignore everything in root by default to avoid tracking other user directories in HOME
/*

# Whitelist project root files
!/.gitignore
!/docker-compose.yml
!/.env.example
!/Makefile
!/README.md
!/docs/
!/docs/**
!/supabase/
!/supabase/**
!/backend/
!/backend/**
!/frontend/
!/frontend/**

# Ignore build artifacts, caches, and secrets within project
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.env
**/.env.local
**/.env.*.local
*.log
.DS_Store
